{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonder plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "author", "version", "apiVersion", "entryAssembly", "entryType"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "description": {"type": "string", "minLength": 1, "maxLength": 4096},
    "author": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "apiVersion": {"const": 1},
    "entryAssembly": {"type": "string", "minLength": 5, "maxLength": 512, "pattern": "\\.[dD][lL][lL]$"},
    "entryType": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
