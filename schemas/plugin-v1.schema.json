{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wonder plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "author",
    "version",
    "apiVersion",
    "entryAssembly",
    "entryType"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "apiVersion": {
      "enum": [1, 2]
    },
    "configurationSchema": {
      "$ref": "#/$defs/configurationSchema"
    },
    "entryAssembly": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "\\.[dD][lL][lL]$"
    },
    "entryType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "permissions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "required": [
          "name",
          "description"
        ],
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string",
            "maxLength": 2048
          },
          "name": {
            "minLength": 1,
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  },
  "$defs": {
    "configurationSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "version": { "const": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "default"],
            "properties": {
              "key": { "type": "string", "pattern": "^[a-zA-Z0-9_.-]{1,80}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 256 },
              "description": { "type": "string", "maxLength": 2048 },
              "type": { "enum": ["string", "boolean", "integer", "number", "choice"] },
              "default": {},
              "minimum": { "type": "number" },
              "maximum": { "type": "number" },
              "maxLength": { "type": "integer", "minimum": 0, "maximum": 65536 },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 128,
                "uniqueItems": true,
                "items": { "type": "string", "maxLength": 256 }
              }
            }
          }
        }
      }
    }
  }
}
