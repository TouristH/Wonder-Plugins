<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <Version>1.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Wonder.Extensibility.Contracts">
      <HintPath>$(WonderContractsPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireWonderContracts" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(WonderContractsPath)')"
           Text="Set WonderContractsPath to the Wonder.Extensibility.Contracts.dll built from Wonder Launcher." />
  </Target>
</Project>
